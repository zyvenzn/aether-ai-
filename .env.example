# Relink Gateway (OpenAI-compatible). Copy this file to .env.local and fill it in.
# Never prefix these with NEXT_PUBLIC_ and never commit the real key.
RELINK_API_KEY=
RELINK_BASE_URL=https://api.relink-gateway.biz.id/v1

# Supabase (login). Publishable key aman dipakai di browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
